{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MPK Deck",
  "version": "0.3.0",
  "identifier": "app.mpkdeck.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 1420 --strictPort",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "MPK Deck", "width": 1140, "height": 780, "minWidth": 720, "minHeight": 540 }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "MPK Deck",
    "icon": ["icons/icon.ico"],
    "resources": { "resources/third-party-notices.txt": "third-party-notices.txt" },
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["Spanish", "English"] } }
  }
}
